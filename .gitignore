# Ambientes virtuais
.venv/
.venv-linux/

# Compilados Python
__pycache__/
*.pyc
*.pyo
*.pyd
*.py[cod]

# Dados gerados (resultados, gráficos, logs)
data/best_improvement/
data/cluster/
data/first_improvement/
data/grafo/
data/local_search/
data/plots/
data/sinteticos/

# Base externa grande (manter localmente, não subir)
data/externo/roadNet-CA.txt.gz

# Logs e temporários
logs/
*.log
*.tmp
*.bak
*.swp
pipeline_checkpoint.json

# Arquivos grandes comuns (fora de reports/)
*.npy
*.pkl
*.graphml
*.out

# Arquivos de metadados e estrutura
estrutura_atual.txt
estrutura_projeto.txt
metadados.txt

# Executáveis ou atalhos do sistema
# (mantemos scripts .sh e .bat versionados)
*.lnk
*.exe
*.dll
*.so

# Configurações de IDEs
.vscode/
.idea/
*.code-workspace

# Arquivos ocultos diversos
.DS_Store
Thumbs.db

# Relatórios agregados: manter versionados
!reports/**
!.gitattributes
